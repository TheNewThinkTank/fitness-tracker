# Optional overrides for fitness-tracker. Defaults work from the repository root.

# Directory containing files named <YEAR>_workouts.yml. Point this directly at
# an athlete-specific directory when using an external or synced data source.
# Quote paths containing spaces; use "My Drive", not "My\ Drive".
FITNESS_TRACKER_DATA_DIR=data
FITNESS_TRACKER_ATHLETE=default

# Direct browser origins are only needed when bypassing the same-origin proxy.
FITNESS_TRACKER_ALLOWED_ORIGINS='["http://localhost:3000","http://localhost:5173"]'

# Optional defense for direct API access. The production reverse proxy injects
# this server-side, so it is never included in the browser bundle.
FITNESS_TRACKER_API_TOKEN=

# Writable SQLite state is separate from imported YAML. Leave empty for
# DATA_DIR/.state locally or Compose's persistent named state volume.
# For synced storage in both modes: "${FITNESS_TRACKER_DATA_DIR}/.state".
FITNESS_TRACKER_STATE_DIR=

# Docker backend identity. For bind-mounted state, use the host's id -u/id -g
# and create .state inside the existing synced data directory as that user.
FITNESS_TRACKER_CONTAINER_UID=10001
FITNESS_TRACKER_CONTAINER_GID=10001

# Provision an athlete password before enabling editing or requiring sign-in.
FITNESS_TRACKER_ENABLE_WRITES=false
FITNESS_TRACKER_AUTH_REQUIRED=false

# Enable Secure cookies behind HTTPS. Leave false for loopback HTTP development.
FITNESS_TRACKER_COOKIE_SECURE=false
